# Variáveis de ambiente usadas pelos serviços.
# Os valores já estão definidos em docker-compose.yml; este arquivo só as documenta.

# api
PORT=3000
MONGODB_URI=mongodb://mongo:27017/clinica?replicaSet=rs0
# banco dos testes que usam o MongoDB (cada arquivo de teste usa clinica_test_<nome>)
MONGODB_URI_TEST=mongodb://mongo:27017/clinica_test?replicaSet=rs0
# pasta com medicos.json e agendamentos.csv
DATA_DIR=/data

# web (destino do proxy /api do Vite)
API_PROXY_TARGET=http://api:3000
